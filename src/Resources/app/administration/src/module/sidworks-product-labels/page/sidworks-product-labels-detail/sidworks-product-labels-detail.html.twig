{% block sidworks_product_labels_detail %}
    <sw-page>
        <template #smart-bar-header>
            <h2>{{ placeholder(label, 'name', 'Product Label') }}</h2>
        </template>

        <template #language-switch>
            <sw-language-switch @on-change="onChangeLanguage"/>
        </template>

        <template #smart-bar-actions>
            <mt-button
                size="default"
                v-tooltip.bottom="tooltipCancel"
                :disabled="isLoading"
                @click="onCancel"
            >
                {{ $tc('global.default.cancel') }}
            </mt-button>

            <sw-button-process
                size="default"
                v-tooltip.bottom="tooltipSave"
                :is-loading="isLoading"
                :process-success="processSuccess"
                variant="primary"
                @click.prevent="onSave"
                @update:process-success="saveFinish"
            >
                {{ $tc('global.default.save') }}
            </sw-button-process>
        </template>

        {% block sidworks_product_labels_detail_content %}
            <template #content>
                <sw-card-view>
                    <mt-card
                        v-if="label"
                        :is-loading="isLoading"
                        :title="$tc('sidworks-product-labels.detail.generalSettings')"
                    >
                        <sw-switch-field
                            :label="$tc('sidworks-product-labels.detail.enabled')"
                            v-model:value="label.active"
                            :style="{ marginTop: '0' }"
                        />

                        <sw-container columns="1fr 1fr" gap="16px">
                            <mt-text-field
                                :label="$tc('sidworks-product-labels.detail.labelInternalName')"
                                v-model="label.name"
                                :error="labelNameError"
                                required
                            />

                            <sw-entity-multi-id-select
                                :label="$tc('sidworks-product-labels.detail.salesChannels')"
                                :repository="salesChannelRepository"
                                v-model:value="label.salesChannelIds"
                                :error="labelSalesChannelIdsError"
                                required
                            />
                        </sw-container>

                        <mt-text-field
                            :label="$tc('sidworks-product-labels.detail.labelContent')"
                            v-model="label.content"
                            :error="labelContentError"
                            required
                        />

                        <sw-entity-single-select
                            :label="$tc('sidworks-product-labels.detail.dynamicProductGroup')"
                            entity="product_stream"
                            v-model:value="label.productStreamId"
                            @update:model-value="onChange"
                            :error="labelProductStreamIdError"
                            show-clearable-button
                        />

                        <sw-entity-multi-id-select
                            v-model:value="label.selectedProducts"
                            :label="$tc('sidworks-product-labels.detail.products')"
                            :repository="productRepository"
                            :criteria="productCriteria"
                            @update:model-value="onChange"
                        >
                            <template #selection-label-property="{ item }">
                                {{ item.translated.name || item.name }} ({{ item.productNumber }})
                            </template>

                            <template #result-label-property="{ item }">
                                {{ item.translated.name || item.name }} ({{ item.productNumber }})
                            </template>
                        </sw-entity-multi-id-select>
                    </mt-card>

                    <mt-card
                        v-if="label"
                        :is-loading="isLoading"
                        :title="$tc('sidworks-product-labels.detail.styling')"
                    >
                        <sw-container columns="1fr 1fr" gap="16px">
                            <mt-colorpicker
                                :label="$tc('sidworks-product-labels.detail.backgroundColor')"
                                v-model="label.backgroundColor"
                                :error="labelBackgroundColorError"
                                required
                            />

                            <mt-colorpicker
                                :label="$tc('sidworks-product-labels.detail.textColor')"
                                v-model="label.textColor"
                                :error="labelTextColorError"
                                required
                            />
                        </sw-container>
                    </mt-card>
                </sw-card-view>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
