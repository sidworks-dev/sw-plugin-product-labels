{% block sidworks_product_labels_detail %}
    <sw-page>
        <template #smart-bar-header>
            <h2>{{ placeholder(label, 'name', 'Product Label') }}</h2>
        </template>

        <template #language-switch>
            <sw-language-switch @on-change="onChangeLanguage"/>
        </template>

        <template #smart-bar-actions>
            <sw-button
                v-tooltip.bottom="tooltipCancel"
                :disabled="isLoading"
                @click="onCancel"
            >
                {{ $tc('global.default.cancel') }}
            </sw-button>

            <sw-button-process
                v-tooltip.bottom="tooltipSave"
                :isLoading="isLoading"
                :processSuccess="processSuccess"
                variant="primary"
                @click.prevent="onSave"
                @update:process-success="saveFinish"
            >
                {{ $tc('global.default.save') }}
            </sw-button-process>
        </template>

        {% block sidworks_product_labels_detail_content %}
            <template #content>
                <sw-card-view>
                    <template>
                        <sw-card
                            v-if="label"
                            :is-loading="isLoading"
                            title="General settings"
                        >
                            <sw-switch-field
                                label="Enabled"
                                v-model:value="label.active"
                                :style="{ marginTop: '0' }"
                            />

                            <sw-container columns="1fr 1fr" gap="16px">
                                <sw-text-field
                                    label="Label internal name"
                                    v-model:value="label.name"
                                    :error="labelNameError"
                                    required
                                >
                                </sw-text-field>

                                <sw-entity-multi-id-select
                                    label="Sales Channels"
                                    :repository="salesChannelRepository"
                                    v-model:value="label.salesChannelIds"
                                    :error="labelSalesChannelIdsError"
                                    required
                                />
                            </sw-container>

                            <sw-text-field
                                label="Label content"
                                v-model:value="label.content"
                                :error="labelContentError"
                                required
                            />

                            <sw-entity-single-select
                                label="Dynamic Product Group"
                                entity="product_stream"
                                v-model:value="label.productStreamId"
                                @update:value="onChange"
                                :error="labelProductStreamIdError"
                                required
                                show-clearable-button
                            />
                        </sw-card>

                        <sw-card
                            v-if="label"
                            :is-loading="isLoading"
                            title="Styling"
                        >
                            <sw-container columns="1fr 1fr" gap="16px">
                                <sw-colorpicker
                                    label="Background color"
                                    v-model:value="label.backgroundColor"
                                    :error="labelBackgroundColorError"
                                    required
                                />

                                <sw-colorpicker
                                    label="Text color"
                                    v-model:value="label.textColor"
                                    :error="labelTextColorError"
                                    required
                                />
                            </sw-container>
                        </sw-card>

                        <sw-card
                                v-if="label"
                                :is-loading="isLoading"
                                title="Scheduling"
                        >
                            <sw-checkbox-field
                                    label="Schedule enabled"
                                    v-model:value="label.fromToActive"
                            />

                            <sw-container columns="1fr 1fr" gap="16px">
                                <sw-datepicker
                                        :disabled="!label.fromToActive"
                                        label="Active From Date"
                                        v-model:value="label.fromDateTime"
                                        date-type="datetime"
                                        :placeholder="'Select a start date, this can be left empty'"
                                />
                                <sw-datepicker
                                        :disabled="!label.fromToActive"
                                        label="Active To Date"
                                        v-model:value="label.toDateTime"
                                        date-type="datetime"
                                        :placeholder="'Select an end date, this can be left empty'"
                                />
                            </sw-container>
                        </sw-card>
                    </template>
                </sw-card-view>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
