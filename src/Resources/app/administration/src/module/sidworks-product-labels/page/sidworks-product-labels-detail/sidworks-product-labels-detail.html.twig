{% block sidworks_product_labels_detail %}
    <sw-page>
        <template #language-switch>
            <sw-language-switch @on-change="onChangeLanguage"/>
        </template>

        <template #smart-bar-actions>
            <sw-button :routerLink="{ name: 'sidworks.product.labels.index' }">
                Cancel
            </sw-button>

            <sw-button-process
                :isLoading="isLoading"
                :processSuccess="processSuccess"
                variant="primary"
                @click.prevent="onSave"
                @update:process-success="saveFinish"
            >
                Save
            </sw-button-process>
        </template>

        {% block sidworks_product_labels_detail_content %}
            <template #content>
                <sw-card-view>
                    <sw-card
                        :isLoading="isLoading"
                        position-identifier="sw-settings-snippet-detail-snippets"
                        title="Product label settings"
                    >
                        <sw-switch-field
                            label="Enabled"
                            v-model:value="item.active"
                            required
                        />

                        <sw-text-field
                            label="Label name"
                            v-model:value="item.name"
                            required
                        />

                        <sw-text-field
                            label="Label content"
                            v-model:value="item.content"
                            required
                        />

                        <sw-colorpicker
                            label="Background color"
                            v-model:value="item.backgroundColor"
                            required
                        />

                        <sw-colorpicker
                            label="Text color"
                            v-model:value="item.textColor"
                            required
                        />

                        <sw-entity-single-select
                            label="Dynamic Product Group"
                            entity="product_stream"
                            v-model:value="item.productStreamId"
                            @update:value="onChange"
                            required
                            show-clearable-button
                        />
                    </sw-card>
                </sw-card-view>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
