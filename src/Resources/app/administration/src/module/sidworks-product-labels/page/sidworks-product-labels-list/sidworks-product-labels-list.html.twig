{% block sidworks_product_labels_list %}
    <sw-page>
        <template #smart-bar-header>
            <h2>
                Product Labels
                <span v-if="!isLoading" class="sw-page__smart-bar-amount">({{ total }})</span>
            </h2>
        </template>

        {% block sidworks_product_labels_list_language_switch %}
            <template #language-switch>
                <sw-language-switch @on-change="onChangeLanguage"/>
            </template>
        {% endblock %}

        {% block sidworks_product_labels_list_smart_bar_actions %}
            <template #smart-bar-actions>
                <sw-button variant="primary" :router-link="{ name: 'sidworks.product.labels.create' }">
                    {{ $tc('sidworks-product-labels.list.addButtonText') }}
                </sw-button>
            </template>
        {% endblock %}

        {% block sidworks_product_labels_list_content %}
            <template #content>
                <sw-entity-listing
                        v-if="labelRepositoryItems && labelRepositoryItems.length > 0"
                        :items="labelRepositoryItems"
                        :repository="labelRepository"
                        :showSelection="false"
                        :columns="columns"
                        detailRoute="sidworks.product.labels.detail"
                        @update-records="updateTotal"
                >
                    <template #column-fromDateTime="{ item }">
                        {{ dateFilter(item.fromDateTime, { hour: '2-digit', minute: '2-digit' }) }}
                    </template>

                    <template #column-toDateTime="{ item }">
                        {{ dateFilter(item.toDateTime, { hour: '2-digit', minute: '2-digit' }) }}
                    </template>
                </sw-entity-listing>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
