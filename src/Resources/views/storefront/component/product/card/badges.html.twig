{% sw_extends '@Storefront/storefront/component/product/card/badges.html.twig' %}

{% block component_product_badges_new %}
    {{ parent() }}

    {% block component_sidworks_product_badges %}
        {% set sidworksProductLabels = product.extensions.sidworksProductLabels ?? null %}

        {% if sidworksProductLabels and sidworksProductLabels.all|length > 0 %}
            {% block component_sidworks_product_badges_elements %}
                {% for sidworksProductLabel in sidworksProductLabels.all %}
                    <div>
                        <span class="badge badge-sidworks-product-labels bg-primary">{{ sidworksProductLabel.content|escape|sw_sanitize }}</span>
                    </div>
                {% endfor %}
            {% endblock %}
        {% endif %}
    {% endblock %}
{% endblock %}
